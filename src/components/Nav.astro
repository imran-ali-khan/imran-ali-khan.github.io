---
import { profile } from '@/data/profile';

const links = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#approach', label: 'Approach' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-ink-800/80 bg-ink-950/80 backdrop-blur-md">
  <nav class="section flex h-16 items-center justify-between" aria-label="Primary">
    <a href="#main" class="inline-flex items-center py-3 font-mono text-sm font-medium tracking-tight text-ink-50">
      Imran<span class="text-signal">.</span>dev
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="link-underline inline-block py-2 text-sm text-ink-300 transition-colors hover:text-ink-50"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden items-center gap-5 md:flex">
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 py-2 text-sm text-ink-300 transition-colors hover:text-ink-50"
        aria-label="GitHub profile"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        GitHub
      </a>
      <a
        href={`${import.meta.env.BASE_URL}${profile.resumeFile}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 py-2 text-sm text-ink-300 transition-colors hover:text-ink-50"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Résumé
      </a>
      <a href="#contact" class="btn-primary !px-5 !py-2.5 text-sm">
        Let's talk
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-md text-ink-100 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
      <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-ink-800 md:hidden">
    <ul class="section flex flex-col gap-1 py-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-2 py-3 text-base text-ink-200 transition-colors hover:bg-ink-800 hover:text-ink-50"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={`${import.meta.env.BASE_URL}${profile.resumeFile}`}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-md px-2 py-3 text-base text-ink-200 transition-colors hover:bg-ink-800 hover:text-ink-50"
        >
          Résumé (PDF)
        </a>
      </li>
      <li class="pt-2">
        <a href="#contact" class="btn-primary w-full">Let's talk</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
