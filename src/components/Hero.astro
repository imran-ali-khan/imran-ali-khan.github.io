---
import { profile } from '@/data/profile';
import DeviceStage from '@/components/DeviceStage.astro';
import TechIcon from '@/components/TechIcon.astro';

const [headlineStart, headlineEnd] = profile.heroHeadline.split(profile.heroHighlight);
---

<section class="relative overflow-hidden pt-16 sm:pt-24" aria-labelledby="hero-heading">
  <!-- Subtle background grid, purely decorative, no motion -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.07]"
    style="background-image: linear-gradient(to right, #6b7280 1px, transparent 1px), linear-gradient(to bottom, #6b7280 1px, transparent 1px); background-size: 56px 56px;"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -top-40 right-0 -z-10 h-[420px] w-[420px] animate-float rounded-full bg-signal/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 left-0 -z-10 h-[320px] w-[320px] animate-float-slow rounded-full bg-signal/[0.06] blur-[110px]"
    aria-hidden="true"
  >
  </div>

  <div class="section grid grid-cols-1 items-center gap-6 pb-16 sm:pb-24 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <div class="enter flex items-start gap-2.5 text-sm text-ink-300">
        <span class="relative mt-1.5 flex h-2 w-2 flex-shrink-0">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-signal"></span>
        </span>
        {profile.availability} &middot; {profile.role} &middot; {profile.location}
      </div>

      <h1
        id="hero-heading"
        class="enter mt-6 max-w-3xl text-4xl font-semibold leading-[1.1] tracking-tight text-ink-50 sm:text-5xl lg:text-[3.4rem]"
        style="animation-delay: 60ms;"
      >
        {headlineStart}<span class="text-gradient">{profile.heroHighlight}</span>{headlineEnd}
      </h1>

      <p class="enter mt-6 max-w-xl text-lg leading-relaxed text-ink-300" style="animation-delay: 120ms;">
        {profile.heroSubline}
      </p>

      <div class="enter mt-9 flex flex-col gap-3 sm:flex-row" style="animation-delay: 180ms;">
        <a href="#projects" class="btn-primary">
          View my work
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="#contact" class="btn-secondary">
          Get in touch
        </a>
      </div>

      <div class="enter mt-8 flex flex-wrap items-center gap-2.5" style="animation-delay: 200ms;" aria-label="Platforms I build for">
        <span class="inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-900/60 px-3.5 py-1.5 text-sm text-ink-100">
          <TechIcon name="flutter" size={18} /> Flutter
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-900/60 px-3.5 py-1.5 text-sm text-ink-100">
          <TechIcon name="android" size={18} /> Android
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-ink-700 bg-ink-900/60 px-3.5 py-1.5 text-sm text-ink-100">
          <TechIcon name="ios" size={18} /> iOS
        </span>
      </div>

      <p class="enter mt-6 max-w-xl text-sm leading-relaxed text-ink-400" style="animation-delay: 220ms;">
        {profile.workModes}
      </p>

      <div class="enter mt-10 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-ink-800 pt-6 text-sm text-ink-400" style="animation-delay: 260ms;">
        <span class="font-mono text-2xs uppercase tracking-[0.15em] text-ink-500">Core stack</span>
        <span>Dart</span>
        <span>Clean Architecture</span>
        <span>Firebase</span>
        <span class="text-signal">AI tools: Claude Code, Cursor</span>
      </div>
    </div>

    <DeviceStage />
  </div>
</section>
