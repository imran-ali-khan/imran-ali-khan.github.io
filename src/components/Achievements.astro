---
import { achievements } from '@/data/profile';

// Split "17+" -> { target: 17, decimals: 0, suffix: '+' }, "4.5+" -> { target: 4.5, decimals: 1, suffix: '+' }.
// Drives the count-up animation below without hardcoding parsed values twice.
const parsed = achievements.map((item) => {
  const match = item.value.match(/^([\d.]+)(.*)$/);
  const numberPart = match ? match[1] : item.value;
  const suffix = match ? match[2] : '';
  const decimals = numberPart.includes('.') ? numberPart.split('.')[1].length : 0;
  return { ...item, target: parseFloat(numberPart) || 0, decimals, suffix };
});
---

<section class="section py-20 sm:py-28" aria-labelledby="achievements-heading">
  <div class="reveal max-w-2xl">
    <p class="section-label">Track record</p>
    <h2 id="achievements-heading" class="mt-3 text-3xl font-semibold text-ink-50 sm:text-4xl">
      Real numbers, nothing inflated
    </h2>
  </div>

  <div class="mt-14 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-ink-800 bg-ink-800 sm:grid-cols-2 lg:grid-cols-4">
    {
      parsed.map((item, i) => (
        <div class="reveal card-hover bg-ink-950 p-7" style={`animation-delay: ${i * 60}ms`}>
          <p class="font-mono text-3xl font-semibold text-signal sm:text-4xl">
            <span class="countup" data-target={item.target} data-decimals={item.decimals} data-suffix={item.suffix}>
              {item.value}
            </span>
          </p>
          <p class="mt-3 text-sm font-medium text-ink-100">{item.label}</p>
          <p class="mt-1 text-xs text-ink-500">{item.detail}</p>
        </div>
      ))
    }
  </div>
</section>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('.countup');

  // The page ships with the real numbers. With JavaScript on, they count up from zero.
  if (!prefersReducedMotion) {
    counters.forEach((el) => {
      el.textContent = `0${el.dataset.suffix || ''}`;
    });
  }

  const animateCounter = (el: HTMLElement) => {
    const target = parseFloat(el.dataset.target || '0');
    const decimals = parseInt(el.dataset.decimals || '0', 10);
    const suffix = el.dataset.suffix || '';

    if (prefersReducedMotion) {
      el.textContent = `${target.toFixed(decimals)}${suffix}`;
      return;
    }

    const duration = 1200;
    const start = performance.now();

    const tick = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const value = target * eased;
      el.textContent = `${value.toFixed(decimals)}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          animateCounter(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.5 }
  );

  counters.forEach((el) => observer.observe(el));
</script>
