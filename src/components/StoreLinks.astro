---
import type { StoreLinks } from '@/data/projects';

interface Props {
  links?: StoreLinks;
  name: string;
}

const { links, name } = Astro.props;
---

{
  links && (links.playStore || links.appStore) && (
    <div class="flex flex-wrap gap-x-4">
      {links.playStore && (
        <a
          href={links.playStore}
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline inline-flex items-center gap-1.5 py-2 text-sm text-ink-300 transition-colors hover:text-signal"
          aria-label={`${name} on Google Play`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20.5V3.5c0-.59.34-1.11.83-1.36l13.69 9.86-13.69 9.86A1.5 1.5 0 0 1 3 20.5zm14.79-9.14L4.42 2.3l10.44 7.53 2.93-2.3-.01-.17zM4.42 21.7l13.37-9.06-2.93-2.3-10.44 11.36z"/></svg>
          Google Play
        </a>
      )}
      {links.appStore && (
        <a
          href={links.appStore}
          target="_blank"
          rel="noopener noreferrer"
          class="link-underline inline-flex items-center gap-1.5 py-2 text-sm text-ink-300 transition-colors hover:text-signal"
          aria-label={`${name} on the App Store`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.13 7.31c1.35.07 2.29.74 3.08.8.99-.16 1.98-.86 3.32-.75 1.34.11 2.34.63 3.02 1.75-2.75 1.65-2.23 5.29.32 6.31-.53 1.65-1.22 3.28-2.82 4.86zM12.03 7.25c-.15-2.23 1.66-4.09 3.74-4.25.29 2.38-2.16 4.4-3.74 4.25z"/></svg>
          App Store
        </a>
      )}
    </div>
  )
}
