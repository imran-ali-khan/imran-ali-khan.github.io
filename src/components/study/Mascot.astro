---
// "Elly", the Element. A friendly blob that keeps State. Parts have classes so scenes can animate them.
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<g class="mascot" id={id}>
  <g class="m-body">
    <ellipse class="m-shadow" cx="0" cy="66" rx="84" ry="11" fill="#1A1B3A" opacity="0.14" />
    <path d="M-86 52 C-96 -40 -50 -92 0 -92 C50 -92 96 -40 86 52 C60 70 -60 70 -86 52Z" fill="#FFC93C" stroke="#1A1B3A" stroke-width="4" stroke-linejoin="round" />
    <path d="M-80 56 C-56 70 56 70 80 56 C70 68 36 74 0 74 C-36 74 -70 68 -80 56Z" fill="#E0A21A" />
    <circle cx="-62" cy="16" r="12" fill="#FF8F6B" opacity="0.55" />
    <circle cx="62" cy="16" r="12" fill="#FF8F6B" opacity="0.55" />
    <g class="m-eyes">
      <circle cx="-30" cy="-22" r="22" fill="#fff" stroke="#1A1B3A" stroke-width="3" />
      <circle cx="30" cy="-22" r="22" fill="#fff" stroke="#1A1B3A" stroke-width="3" />
      <g class="m-pupils">
        <circle class="m-pl" cx="-30" cy="-20" r="10" fill="#1A1B3A" />
        <circle class="m-pr" cx="30" cy="-20" r="10" fill="#1A1B3A" />
      </g>
    </g>
    <path class="m-mouth" d="M-16 20 Q0 34 16 20" stroke="#1A1B3A" stroke-width="5" fill="none" stroke-linecap="round" />
  </g>
</g>
