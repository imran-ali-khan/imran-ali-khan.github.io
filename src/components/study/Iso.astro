---
// Three layers in 3D: the Widget tree on top, the Element tree in the middle, RenderObjects at the bottom.
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['iso-wrap', { compact }]} aria-hidden="true">
  <div class="iso">
    <div class="layer l-render" style="--z:0; --c:#34d399">
      <span class="lname">RenderObjects</span>
      <div class="tiles">
        <i class="solid"></i><i class="solid"></i><i class="solid"></i><i class="solid"></i>
      </div>
    </div>
    <div class="layer l-element" style="--z:1; --c:#a78bfa">
      <span class="lname">Elements</span>
      <div class="tiles">
        <i class="dot">E1</i><i class="dot hot">E2</i><i class="dot">E3</i><i class="dot">E4</i>
      </div>
    </div>
    <div class="layer l-widget" style="--z:2; --c:#38bdf8">
      <span class="lname">Widgets</span>
      <div class="tiles">
        <i class="card">Text</i><i class="card">Column</i><i class="card">Button</i><i class="card">Padding</i>
      </div>
    </div>
  </div>
</div>
