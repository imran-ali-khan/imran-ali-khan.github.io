---
// A flow diagram: boxes joined by "-->" arrows. Boxes light up one by one when the slide opens.
type Color = 'blue' | 'violet' | 'green' | 'amber' | 'rose' | 'slate';

interface Step {
  t: string;
  s?: string;
  c?: Color;
}

interface Props {
  steps: Step[];
  col?: boolean;
  label?: string;
}

const { steps, col = false, label } = Astro.props;
---

<div class="flow-wrap">
  {label && <p class="flow-label">{label}</p>}
  <ol class:list={['flow', { 'flow-col': col }]}>
    {
      steps.map((step, i) => (
        <>
          {i > 0 && (
            <li class="arrow" aria-hidden="true" style={`--i:${i}`}>
              <span>{'-->'}</span>
            </li>
          )}
          <li class={`fnode c-${step.c ?? 'blue'}`} style={`--i:${i}`}>
            <b>{step.t}</b>
            {step.s && <small>{step.s}</small>}
          </li>
        </>
      ))
    }
  </ol>
</div>
