---
interface Props {
  chapter: string;
  title: string;
  kicker?: string;
  lead?: string;
  n: number;
}

const { chapter, title, kicker, lead, n } = Astro.props;
---

<section class="slide" data-chapter={chapter} aria-roledescription="slide" aria-label={`${n}. ${title}`}>
  <div class="slide-in">
    <header class="sh">
      <p class="kick"><span class="chip">{chapter}</span>{kicker && <span class="kick-text">{kicker}</span>}</p>
      <h2>{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </header>
    <div class="sb">
      <slot />
    </div>
  </div>
</section>
