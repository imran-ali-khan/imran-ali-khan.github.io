---
// The Flutter logo in its two blues. Used to show what the lesson is about.
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: cls = '' } = Astro.props;
---

<svg class={`flogo ${cls}`} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path fill="#54C5F8" d="M14.314 0L2.3 12 6 15.7 21.684.013h-7.357z" />
  <path fill="#01579B" d="M14.328 11.072L7.857 17.53l6.47 6.47H21.7l-6.46-6.468 6.46-6.46h-7.372z" />
</svg>
