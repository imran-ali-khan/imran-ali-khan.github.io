---
// Small brand logos for Flutter, Android, and iOS (the Apple logo).
// They are used only to say "I build for these", the way many developers do.
interface Props {
  name: 'flutter' | 'android' | 'ios';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

{
  name === 'flutter' && (
    <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="#54C5F8" aria-hidden="true" class={className}>
      <path d="M14.314 0L2.3 12 6 15.7 21.684.013h-7.357zm.014 11.072L7.857 17.53l6.47 6.47H21.7l-6.46-6.468 6.46-6.46h-7.37z" />
    </svg>
  )
}
{
  name === 'android' && (
    <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path fill="#3DDC84" d="M5.5 17.5a6.5 6.5 0 0 1 13 0z" />
      <path d="M8.6 10.6 7.2 8.2m8.2 2.4 1.4-2.4" stroke="#3DDC84" stroke-width="1.3" stroke-linecap="round" fill="none" />
      <circle cx="9.7" cy="14.2" r="0.8" fill="#0a0b0d" />
      <circle cx="14.3" cy="14.2" r="0.8" fill="#0a0b0d" />
    </svg>
  )
}
{
  name === 'ios' && (
    <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="#e6e8ec" aria-hidden="true" class={className}>
      <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.13 7.31c1.35.07 2.29.74 3.08.8.99-.16 1.98-.86 3.32-.75 1.34.11 2.34.63 3.02 1.75-2.75 1.65-2.23 5.29.32 6.31-.53 1.65-1.22 3.28-2.82 4.86zM12.03 7.25c-.15-2.23 1.66-4.09 3.74-4.25.29 2.38-2.16 4.4-3.74 4.25z" />
    </svg>
  )
}
