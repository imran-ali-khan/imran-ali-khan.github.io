---
import { faq } from '@/data/profile';
---

<section id="faq" class="section py-20 sm:py-28" aria-labelledby="faq-heading">
  <div class="reveal max-w-2xl">
    <p class="section-label">Questions</p>
    <h2 id="faq-heading" class="mt-3 text-3xl font-semibold text-ink-50 sm:text-4xl">
      Quick answers
    </h2>
    <p class="mt-4 text-ink-400">The things people ask me most.</p>
  </div>

  <div class="mt-10 max-w-3xl divide-y divide-ink-800 border-y border-ink-800">
    {
      faq.map((item, i) => (
        <details class="group reveal" style={`animation-delay: ${i * 40}ms`} open={i === 0}>
          <summary class="flex min-h-[3.5rem] cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-base font-medium text-ink-50 marker:hidden">
            <h3 class="text-base font-medium">{item.question}</h3>
            <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full border border-ink-700 text-ink-300 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="max-w-2xl pb-5 leading-relaxed text-ink-300">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
