---
import { profile, quickFacts } from '@/data/profile';

const base = import.meta.env.BASE_URL;
---

<section id="about" class="section py-20 sm:py-28" aria-labelledby="about-heading">
  <div class="grid grid-cols-1 gap-12 lg:grid-cols-[280px_1fr]">
    <div class="reveal">
      <p class="section-label">About</p>
      <h2 id="about-heading" class="mt-3 text-3xl font-semibold text-ink-50 sm:text-4xl">
        About me
      </h2>
      {
        profile.photo && (
          <img
            src={`${base}${profile.photo}`}
            alt={`${profile.name}, ${profile.role} from ${profile.location}`}
            width="320"
            height="320"
            loading="lazy"
            decoding="async"
            class="mt-8 aspect-square w-56 rounded-3xl border border-ink-700 object-cover shadow-[0_24px_60px_-24px_rgba(56,189,248,0.35)] lg:w-full"
          />
        )
      }
    </div>

    <div class="reveal max-w-2xl" style="animation-delay: 80ms;">
      <div class="space-y-5">
        {profile.aboutNarrative.map((paragraph) => (
          <p class="text-ink-300 leading-relaxed">{paragraph}</p>
        ))}
      </div>

      <h3 class="mt-12 text-lg font-semibold text-ink-50">At a glance</h3>
      <dl class="mt-4 grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
        {
          quickFacts.map((fact) => (
            <div class="flex gap-3 border-b border-ink-800 pb-3 text-sm">
              <dt class="w-28 flex-shrink-0 text-ink-500">{fact.label}</dt>
              <dd class="text-ink-200">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
