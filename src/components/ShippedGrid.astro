---
import { shipped } from '@/data/projects';
import { appImages } from '@/data/appImages';
import StoreLinks from '@/components/StoreLinks.astro';

const base = import.meta.env.BASE_URL;
---

<div>
  <h3 class="text-xl font-semibold text-ink-50">Also shipped</h3>
  <p class="mt-2 max-w-xl text-ink-400">
    More apps I worked on and helped release with clients and teams. Most are real estate CRMs in Dubai, plus delivery, shopping, and kids apps.
  </p>

  <ul class="mt-8 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3" style="perspective: 1400px;">
    {
      shipped.map((app, index) => (
        <li
          class="reveal tilt group flex flex-col overflow-hidden rounded-2xl border border-ink-800 bg-ink-900/50 transition-colors hover:border-ink-700"
          data-tilt="4"
          style={`animation-delay: ${(index % 3) * 70}ms`}
        >
          <div class="media">
            {app.images ? (
              app.images.map((src, i) => (
                <img
                  class={`shot p${i}`}
                  src={`${base}${src}`}
                  alt={`${app.name} app screen ${i + 1}`}
                  width={appImages[src].w}
                  height={appImages[src].h}
                  loading="lazy"
                  decoding="async"
                />
              ))
            ) : (
              <span class="initial" aria-hidden="true">{app.name.charAt(0)}</span>
            )}
          </div>

          <div class="flex flex-1 flex-col gap-2 p-5">
            <h4 class="text-base font-semibold text-ink-50">{app.name}</h4>
            <p class="text-sm leading-relaxed text-ink-400">{app.description}</p>
            <div class="mt-auto pt-3">
              <StoreLinks links={app.links} name={app.name} />
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .media {
    position: relative;
    display: flex;
    justify-content: center;
    height: 214px;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.18), transparent 70%),
      linear-gradient(180deg, #14181f, #0f1217);
    border-bottom: 1px solid #1c2028;
  }
  .media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 56px;
    background: linear-gradient(to top, #0f1217, transparent);
    pointer-events: none;
  }
  /* Three screenshots in a fan: the middle one is in front and a little bigger. */
  .shot {
    position: absolute;
    top: 20px;
    height: auto;
    border-radius: 16px 16px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 0;
    box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.85);
    transform-origin: 50% 100%;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .p0 {
    width: 112px;
    left: calc(50% - 134px);
    z-index: 1;
    transform: rotate(-6deg) scale(0.94);
  }
  .p1 {
    width: 128px;
    left: calc(50% - 64px);
    top: 14px;
    z-index: 3;
  }
  .p2 {
    width: 112px;
    left: calc(50% + 22px);
    z-index: 2;
    transform: rotate(6deg) scale(0.94);
  }
  .group:hover .p0 {
    transform: translateX(-10px) rotate(-10deg) scale(0.94);
  }
  .group:hover .p1 {
    transform: translateY(-8px) scale(1.03);
  }
  .group:hover .p2 {
    transform: translateX(10px) rotate(10deg) scale(0.94);
  }
  .initial {
    align-self: center;
    font-size: 72px;
    font-weight: 700;
    color: rgba(56, 189, 248, 0.5);
    padding-bottom: 18px;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot {
      transition: none;
    }
  }
</style>
