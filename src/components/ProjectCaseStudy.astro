---
import type { CaseStudy } from '@/data/projects';
import StoreLinks from '@/components/StoreLinks.astro';
import { appImages } from '@/data/appImages';

interface Props {
  project: CaseStudy;
  index: number;
}

const { project, index } = Astro.props;
const base = import.meta.env.BASE_URL;
const picture = project.image ? appImages[project.image.src] : undefined;
const reversed = index % 2 === 1;
---

<article
  id={project.slug}
  class:list={[
    'reveal grid grid-cols-1 gap-x-16 gap-y-10 border-t border-ink-800 py-14 lg:grid-cols-2',
  ]}
  aria-labelledby={`${project.slug}-heading`}
>
  <div class:list={[reversed && 'lg:order-2']}>
    <p class="section-label">{String(index + 1).padStart(2, '0')} / Case Study</p>
    <h3 id={`${project.slug}-heading`} class="mt-3 text-2xl font-semibold text-ink-50 sm:text-3xl">
      {project.name}
    </h3>
    <p class="mt-2 text-ink-400">{project.tagline}</p>

    <dl
      class:list={[
        'mt-6 grid grid-cols-2 gap-4 border-y border-ink-800 py-5 text-sm',
        project.company ? 'sm:grid-cols-3' : 'sm:grid-cols-2',
      ]}
    >
      <div>
        <dt class="text-ink-500">Role</dt>
        <dd class="mt-1 text-ink-200">{project.role}</dd>
      </div>
      {project.company && (
        <div>
          <dt class="text-ink-500">Company</dt>
          <dd class="mt-1 text-ink-200">{project.company}</dd>
        </div>
      )}
      <div>
        <dt class="text-ink-500">Links</dt>
        <dd class="mt-1">
          {project.links ? (
            <StoreLinks links={project.links} name={project.name} />
          ) : (
            <span class="text-ink-500">Internal / not public</span>
          )}
        </dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-2">
      {project.tech.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>

    {
      project.image && picture && (
        <div class="shot-frame mt-8">
          <img
            src={`${base}${project.image.src}`}
            alt={project.image.alt}
            width={picture.w}
            height={picture.h}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
  </div>

  <div class:list={[reversed && 'lg:order-1']}>
    <div class="space-y-6">
      <div>
        <h4 class="text-sm font-semibold text-ink-50">The problem</h4>
        <p class="mt-2 text-sm leading-relaxed text-ink-300">{project.problem}</p>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-ink-50">Approach</h4>
        <ul class="mt-2 space-y-2">
          {project.approach.map((step) => (
            <li class="flex gap-3 text-sm leading-relaxed text-ink-300">
              <span class="mt-2 h-1 w-1 flex-shrink-0 rounded-full bg-ink-500" aria-hidden="true" />
              <span>{step}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-ink-50">Architecture</h4>
        <p class="mt-2 text-sm leading-relaxed text-ink-300">{project.architecture}</p>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-ink-50">Key challenge</h4>
        <p class="mt-2 text-sm leading-relaxed text-ink-300">{project.challenge}</p>
      </div>

      <div class="rounded-lg border border-signal/20 bg-signal/[0.04] p-4">
        <h4 class="text-sm font-semibold text-signal">Result</h4>
        <p class="mt-2 text-sm leading-relaxed text-ink-200">{project.result}</p>
      </div>
    </div>
  </div>
</article>

<style>
  .shot-frame {
    width: 210px;
    height: 300px;
    overflow: hidden;
    border-radius: 24px 24px 0 0;
    border: 1px solid #22262e;
    border-bottom: 0;
    background: #0f1217;
    box-shadow: 0 30px 60px -30px rgba(56, 189, 248, 0.35);
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }
  .shot-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
