---
import { caseStudies } from '@/data/projects';
import ProjectCaseStudy from '@/components/ProjectCaseStudy.astro';
import ShippedGrid from '@/components/ShippedGrid.astro';
import AppShowcase from '@/components/AppShowcase.astro';
---

<section id="projects" class="section py-20 sm:py-28" aria-labelledby="projects-heading">
  <div class="reveal max-w-2xl">
    <p class="section-label">Projects</p>
    <h2 id="projects-heading" class="mt-3 text-3xl font-semibold text-ink-50 sm:text-4xl">
      Apps I have built
    </h2>
    <p class="mt-4 text-ink-400">
      Real screens from apps that are live in the stores. If you want the full story behind {caseStudies.length} of them, the
      case studies are at the bottom.
    </p>
  </div>

  <AppShowcase />

  <div class="reveal mt-16 border-t border-ink-800 pt-16">
    <ShippedGrid />
  </div>

  <div id="case-studies" class="mt-20 border-t border-ink-800 pt-16" aria-labelledby="case-studies-heading">
    <div class="reveal max-w-2xl">
      <p class="section-label">Case studies</p>
      <h3 id="case-studies-heading" class="mt-3 text-2xl font-semibold text-ink-50 sm:text-3xl">
        The full story behind {caseStudies.length} projects
      </h3>
      <p class="mt-3 text-ink-400">
        For each one: the problem, what I did, how it was built, what was hard, and how it ended.
      </p>
    </div>

    <div class="mt-6">
      {caseStudies.map((project, index) => (
        <ProjectCaseStudy project={project} index={index} />
      ))}
    </div>
  </div>
</section>
