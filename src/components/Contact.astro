---
import { profile } from '@/data/profile';
---

<section id="contact" class="relative overflow-hidden border-t border-ink-800 py-24 sm:py-32">
  <div
    class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[380px] w-[600px] -translate-x-1/2 animate-float-slow rounded-full bg-signal/10 blur-[140px]"
    aria-hidden="true"
  >
  </div>

  <div class="section text-center">
    <p class="reveal section-label justify-center">Contact</p>
    <h2 class="reveal mx-auto mt-4 max-w-2xl text-3xl font-semibold text-ink-50 sm:text-4xl lg:text-5xl" style="animation-delay: 60ms;">
      Let's build something that ships.
    </h2>
    <p class="reveal mx-auto mt-5 max-w-xl text-ink-400" style="animation-delay: 120ms;">
      {profile.availability} and open to Flutter engineering roles and freelance projects. {profile.workModes}
    </p>

    <div class="reveal mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row" style="animation-delay: 180ms;">
      <a href={`mailto:${profile.email}`} class="btn-primary">
        Email me
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href={profile.links.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.36.101 11.943c0 2.105.549 4.161 1.595 5.976L0 24l6.223-1.634a11.9 11.9 0 0 0 5.822 1.478h.005c6.583 0 11.941-5.363 11.943-11.945 0-3.19-1.24-6.19-3.489-8.44"/></svg>
        WhatsApp
      </a>
      <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary">
        Connect on LinkedIn
      </a>
    </div>

    <dl class="reveal mx-auto mt-16 grid max-w-3xl grid-cols-1 gap-px overflow-hidden rounded-xl border border-ink-800 bg-ink-800 text-left sm:grid-cols-2 lg:grid-cols-4" style="animation-delay: 240ms;">
      <div class="card-hover bg-ink-950 p-5">
        <dt class="flex items-center gap-2 text-xs uppercase tracking-[0.1em] text-ink-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="#EA4335" d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-.339.108-.653.294-.91L12 12.909 23.706 4.547c.186.257.294.571.294.91zM12 12.909 23.706 4.547A1.636 1.636 0 0 0 22.364 3.82H1.636A1.636 1.636 0 0 0 .294 4.547L12 12.909z"/></svg>
          Email
        </dt>
        <dd class="mt-2">
          <a href={`mailto:${profile.email}`} class="link-underline text-sm text-ink-200 transition-colors hover:text-signal break-all">
            {profile.email}
          </a>
        </dd>
      </div>
      <div class="card-hover bg-ink-950 p-5">
        <dt class="flex items-center gap-2 text-xs uppercase tracking-[0.1em] text-ink-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-signal" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Phone
        </dt>
        <dd class="mt-2">
          <a href={`tel:${profile.phone.replace(/\s/g, '')}`} class="link-underline text-sm text-ink-200 transition-colors hover:text-signal">
            {profile.phone}
          </a>
        </dd>
      </div>
      <div class="card-hover bg-ink-950 p-5">
        <dt class="flex items-center gap-2 text-xs uppercase tracking-[0.1em] text-ink-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="#25D366" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.36.101 11.943c0 2.105.549 4.161 1.595 5.976L0 24l6.223-1.634a11.9 11.9 0 0 0 5.822 1.478h.005c6.583 0 11.941-5.363 11.943-11.945 0-3.19-1.24-6.19-3.489-8.44"/></svg>
          WhatsApp
        </dt>
        <dd class="mt-2">
          <a
            href={profile.links.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline text-sm text-ink-200 transition-colors hover:text-signal"
          >
            {profile.phone}
          </a>
        </dd>
      </div>
      <div class="card-hover bg-ink-950 p-5">
        <dt class="flex items-center gap-2 text-xs uppercase tracking-[0.1em] text-ink-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-signal" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Location
        </dt>
        <dd class="mt-2 text-sm text-ink-200">{profile.location}</dd>
      </div>
    </dl>
  </div>
</section>
