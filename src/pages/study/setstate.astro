---
import StudyLayout from '@/layouts/StudyLayout.astro';
import Mascot from '@/components/study/Mascot.astro';
import IsoStack from '@/components/study/IsoStack.astro';
import Flow from '@/components/study/Flow.astro';
import Src from '@/components/study/Src.astro';
import pointer from '@/icons/lucide/pointer.svg?raw';
import flag from '@/icons/lucide/flag.svg?raw';
import timer from '@/icons/lucide/timer.svg?raw';
import hammer from '@/icons/lucide/hammer.svg?raw';
import compare from '@/icons/lucide/git-compare.svg?raw';
import brush from '@/icons/lucide/paintbrush.svg?raw';

const base = import.meta.env.BASE_URL;
const D = 'https://api.flutter.dev/flutter/widgets/';
const inner = (svg: string) => svg.replace(/<!--[\s\S]*?-->/g, '').replace(/<svg[^>]*>/, '').replace('</svg>', '');

const stations = [
  { name: 'setState()', sub: 'your code', icon: pointer },
  { name: 'Mark', sub: 'flag + dirty list', icon: flag },
  { name: 'Wait', sub: 'next frame', icon: timer },
  { name: 'Build', sub: 'dirty Elements only', icon: hammer },
  { name: 'Compare', sub: 'reuse or recreate', icon: compare },
  { name: 'Draw', sub: 'what changed', icon: brush },
];
const SY = (i: number) => 78 + i * 100;

const interview = `setState runs my callback and marks that Element dirty. Flutter schedules a frame. In that frame, it calls build() only on dirty Elements, parents first. build() returns new widgets. updateChild compares old and new: same object, skip; same type and key, reuse the Element; otherwise a new Element, and the State is lost. So only the subtree under that State rebuilds, not the whole app. RenderObjects update only when a value really changed.`;

const labels = ['Start', 'Words', 'Why', 'Trees', 'Journey', 'Batching', 'Compare', 'Reach', 'Recap', 'Expert'];
---

<StudyLayout
  title="setState() explained visually | Flutter Under the Hood"
  description="A short visual guide to what happens inside Flutter when you call setState()."
>
  <div class="study-bg"></div>

  <header class="bar">
    <a href={`${base}study/`}>&larr; Study</a>
    <span class="brand"><b>F</b>Flutter Under the Hood</span>
    <span class="ep">Episode 01</span>
  </header>

  <main class="stage" id="stage">
    <!-- 0 · Start -->
    <section class="act on" id="act-0" data-label="Start" aria-label="Start">
      <div class="panel">
        <h1>What happens when you call <em>setState()</em>?</h1>
        <p class="lead">A visual guide. Simple words.</p>
        <div class="explain"><b>In simple words</b><p>setState() tells Flutter: my data changed, please redraw. We will see how, step by step, with a restaurant story.</p></div>
        <Flow label="The whole story" items={[{ t: 'setState()', c: 'y' }, { t: 'mark dirty', c: 'y' }, { t: 'wait for frame', c: 'n' }, { t: 'build', c: 'b' }, { t: 'compare', c: 'b' }, { t: 'draw', c: 'g' }]} />
        <div class="ctl"><button class="btn primary" id="start" type="button">Start &rarr;</button><button class="btn" id="skip" type="button">I know Flutter: expert answers</button></div>
        <p class="cap" style="min-height:0;font-size:15px">Use the arrow keys, swipe, or the buttons below.</p>
        <Src links={[{ label: 'State.setState', href: 'https://api.flutter.dev/flutter/widgets/State/setState.html' }]} />
      </div>
      <div class="scene"><IsoStack id="iso-intro" /></div>
    </section>


    <!-- Words (beginner basics) -->
    <section class="act" id="act-words" data-label="Words" aria-label="Words">
      <div class="panel">
        <p class="kick"><i>1</i>New to Flutter?</p>
        <h2>Four words <em>first</em>.</h2>
        <div class="explain"><b>In simple words</b><p>Imagine a restaurant. You order. The waiter looks after your table. The chef cooks. Flutter works the same way.</p></div>
        <Flow label="The restaurant story" items={[{ t: 'You: setState()', c: 'y' }, { t: 'Waiter: Element', c: 'y' }, { t: 'Order slip: Widget', c: 'b' }, { t: 'Chef: RenderObject', c: 'g' }]} />
        <Src links={[{ label: 'Architecture overview', href: 'https://docs.flutter.dev/resources/architectural-overview' }]} />
      </div>
      <div class="scene">
        <div class="words" id="words">
          <div class="word"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="10" width="36" height="28" rx="6" fill="#B4C2FF" stroke="#1A1B3A" stroke-width="3" stroke-dasharray="6 4" /><rect x="12" y="18" width="24" height="5" rx="2.5" fill="#1A1B3A" /><rect x="12" y="27" width="14" height="5" rx="2.5" fill="#1A1B3A" /></svg><h3>Widget</h3><p>A small piece of the screen. A button, a text, a picture.</p><code>Text('Hello')</code></div>
          <div class="word"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="18" fill="#FFC93C" stroke="#1A1B3A" stroke-width="3" /><text x="24" y="31" text-anchor="middle" font-size="22" font-weight="900" fill="#1A1B3A">3</text></svg><h3>State</h3><p>Data that can change. A counter, a name, a switch.</p><code id="w-state">count = 3</code></div>
          <div class="word"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#1A1B3A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path d="M8 16H3v5" /></svg><h3>Rebuild</h3><p>Flutter draws a piece again, with the new data.</p><code>3 --&gt; 4</code></div>
          <div class="word"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="#1A1B3A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={inner(timer)} /><h3>Frame</h3><p>One redraw of the screen. About 60 every second.</p><code>1 sec = 60 frames</code></div>
        </div>
      </div>
    </section>

    <!-- 1 · Why -->
    <section class="act" id="act-1" data-label="Why" aria-label="Why">
      <div class="panel">
        <p class="kick"><i>2</i>Why</p>
        <h2>Variables don't <em>redraw</em> the screen.</h2>
        <div class="explain"><b>In simple words</b><p>A variable is just a note in memory. Flutter does not read your notes. After you change one, call setState() to say: please redraw.</p><p class="think"><i>Like a restaurant:</i> you change your mind about your order, but the waiter does not know until you tell them.</p></div>
        <p class="cap" id="why-cap" aria-live="polite">Press count++.</p>
        <div class="ctl">
          <button class="btn" id="why-inc" type="button">count++</button>
          <button class="btn primary" id="why-set" type="button">setState()</button>
        </div>
        <Flow label="Without setState" items={[{ t: 'count++', c: 'n' }, { t: 'memory changes', c: 'n' }, { t: 'screen stays old', c: 'r' }]} />
        <Flow label="With setState" items={[{ t: 'setState()', c: 'y' }, { t: 'Flutter is told', c: 'y' }, { t: 'screen redraws', c: 'g' }]} />
        <Src links={[{ label: 'State.setState', href: 'https://api.flutter.dev/flutter/widgets/State/setState.html' }]} />
      </div>
      <div class="scene">
        <svg viewBox="0 0 900 680" role="img" aria-label="A variable, a wire, a sleeping mascot, and a phone screen">
          <rect x="40" y="120" width="300" height="260" rx="30" fill="#F3F4FF" stroke="#1A1B3A" stroke-width="4" />
          <text x="70" y="176" font-size="28" font-weight="900" fill="#53557E">variable</text>
          <text class="mono" x="70" y="226" font-size="30" font-weight="700" fill="#1A1B3A">count =</text>
          <text id="why-var" x="190" y="345" text-anchor="middle" font-size="112" font-weight="900" fill="#1A1B3A">0</text>
          <path id="why-wire" d="M340 250 C430 250 450 330 560 330" fill="none" stroke="#1A1B3A" stroke-width="5" stroke-dasharray="1 14" stroke-linecap="round" />
          <path id="why-wire-on" d="M340 250 C430 250 450 330 560 330" fill="none" stroke="#3DDC97" stroke-width="10" stroke-linecap="round" stroke-dasharray="600" stroke-dashoffset="600" />
          <circle id="why-pulse" r="15" fill="#FFC93C" stroke="#1A1B3A" stroke-width="3" opacity="0" />
          <g transform="translate(560 60)">
            <rect width="300" height="560" rx="48" fill="#1A1B3A" />
            <rect x="14" y="14" width="272" height="532" rx="36" fill="#fff" />
            <rect x="105" y="26" width="90" height="12" rx="6" fill="#1A1B3A" />
            <text id="why-screen" x="150" y="330" text-anchor="middle" font-size="210" font-weight="900" fill="#1A1B3A">0</text>
            <text x="150" y="500" text-anchor="middle" font-size="28" font-weight="800" fill="#53557E">the screen</text>
          </g>
          <Mascot id="why-m" />
          <g id="why-bubble" opacity="0">
            <rect x="60" y="440" width="270" height="68" rx="24" fill="#fff" stroke="#1A1B3A" stroke-width="4" />
            <path d="M300 508 L340 540 L330 506Z" fill="#fff" stroke="#1A1B3A" stroke-width="4" stroke-linejoin="round" />
            <path d="M296 504 L328 504" stroke="#fff" stroke-width="7" />
            <text id="why-bubble-t" x="195" y="485" text-anchor="middle" font-size="26" font-weight="900" fill="#1A1B3A">Nobody told me!</text>
          </g>
          <text id="why-z" x="500" y="470" font-size="40" font-weight="900" fill="#5B7CFF">z z z</text>
        </svg>
      </div>
    </section>

    <!-- 2 · Trees -->
    <section class="act" id="act-2" data-label="Trees" aria-label="Trees">
      <div class="panel">
        <p class="kick"><i>3</i>The big picture</p>
        <h2>Flutter keeps <em>three</em> trees.</h2>
        <ul class="legend">
          <li style="--c:var(--blue)"><i></i><span><b>Widget</b> the blueprint. Replaced often.</span></li>
          <li style="--c:var(--yellow)"><i></i><span><b>Element</b> the manager. Keeps State.</span></li>
          <li style="--c:var(--mint)"><i></i><span><b>RenderObject</b> draws pixels.</span></li>
        </ul>
        <div class="explain"><b>In simple words</b><p>Flutter keeps three lists. Widgets say what the screen should look like. Elements are the managers. RenderObjects do the drawing.</p><p class="think"><i>Like a restaurant:</i> order slip (Widget), waiter (Element), chef (RenderObject). New slip every time, same waiter.</p></div>
        <p class="cap" id="trees-cap" aria-live="polite">Press the button.</p>
        <div class="ctl"><button class="btn yellow" id="trees-go" type="button">Press setState()</button></div>
        <Flow label="Who does what" items={[{ t: 'Widget: describes', c: 'b' }, { t: 'Element: manages + State', c: 'y' }, { t: 'RenderObject: layout + paint', c: 'g' }]} />
        <Src links={[{ label: 'Architecture overview', href: 'https://docs.flutter.dev/resources/architectural-overview' }, { label: 'Element', href: 'https://api.flutter.dev/flutter/widgets/Element-class.html' }]} />
      </div>
      <div class="scene"><IsoStack id="iso-trees" bolt /></div>
    </section>

    <!-- 3 · Journey -->
    <section class="act" id="act-3" data-label="Journey" aria-label="Journey">
      <div class="panel">
        <p class="kick"><i>4</i>Behind the scenes</p>
        <h2>The journey of one <em>setState()</em>.</h2>
        <div class="explain"><b>In simple words</b><p>One setState() goes through six stations. Your code does only the first. <b>Dirty</b> simply means: marked as needing an update.</p><p class="think"><i>Like a restaurant:</i> you call the waiter. He writes your table on his update list. In the next kitchen round he fixes your order.</p></div>
        <div class="result" id="j-box"><b id="j-num">1 / 6</b><p id="j-title"></p></div>
        <p class="cap" id="j-text" aria-live="polite"></p>
        <div class="flowbox" id="j-flow"></div>
        <div class="ctl">
          <button class="btn" id="j-prev" type="button" aria-label="Previous station">&larr;</button>
          <button class="btn primary" id="j-next" type="button">Next &rarr;</button>
        </div>
        <Src links={[{ label: 'markNeedsBuild', href: 'https://api.flutter.dev/flutter/widgets/Element/markNeedsBuild.html' }, { label: 'scheduleBuildFor', href: 'https://api.flutter.dev/flutter/widgets/BuildOwner/scheduleBuildFor.html' }, { label: 'buildScope', href: 'https://api.flutter.dev/flutter/widgets/BuildOwner/buildScope.html' }]} />
      </div>
      <div class="scene">
        <svg class="journey" id="journey" viewBox="0 0 560 680" role="img" aria-label="The six stations of a setState call">
          <g fill="none" stroke="#1A1B3A" stroke-width="3" stroke-linecap="round">
            <path d={`M506 ${SY(0) - 36} h16 v${SY(1) - SY(0) + 72} h-16`} />
            <path d={`M506 ${SY(2) - 36} h16 v${SY(5) - SY(2) + 72} h-16`} />
          </g>
          <text transform={`translate(548 ${(SY(0) + SY(1)) / 2}) rotate(90)`} text-anchor="middle" font-size="18" font-weight="900">NOW</text>
          <text transform={`translate(548 ${(SY(2) + SY(5)) / 2}) rotate(90)`} text-anchor="middle" font-size="18" font-weight="900">NEXT FRAME</text>
          <line x1="110" y1={SY(0)} x2="110" y2={SY(5)} stroke="#1A1B3A" stroke-opacity="0.35" stroke-width="4" stroke-dasharray="1 12" stroke-linecap="round" />
          <line id="j-prog" x1="110" y1={SY(0)} x2="110" y2={SY(5)} stroke="#1A1B3A" stroke-width="6" stroke-linecap="round" />
          {
            stations.map((s, i) => (
              <g class="st" data-i={i} data-y={SY(i)} transform={`translate(110 ${SY(i)})`} role="button" tabindex="0" aria-label={s.name}>
                <circle class="ring" r="48" fill="none" stroke="#FFC93C" stroke-width="5" opacity="0" />
                <circle class="d" r="38" />
                <g class="ico" transform="translate(-20 -20) scale(1.67)" set:html={inner(s.icon)} />
                <text class="nm" x="68" y="-2" font-size="30">{s.name}</text>
                <text class="sb" x="68" y="26" font-size="21">{s.sub}</text>
              </g>
            ))
          }
          <g id="j-token">
            <path d="M0 0 L-16 -13 L-16 13Z" fill="#5B7CFF" stroke="#1A1B3A" stroke-width="3" stroke-linejoin="round" />
          </g>
        </svg>
      </div>
    </section>

    <!-- 4 · Batching -->
    <section class="act" id="act-4" data-label="Batching" aria-label="Batching">
      <div class="panel">
        <p class="kick"><i>5</i>The wait</p>
        <h2>Many calls. <em>One</em> rebuild.</h2>
        <div class="explain"><b>In simple words</b><p>Flutter updates the screen in rounds called <b>frames</b>. Call setState() many times in one round, and it still updates only once.</p><p class="think"><i>Like a restaurant:</i> you change your order 5 times before the kitchen round. The waiter still sends one slip.</p></div>
        <p class="cap" id="b-cap" aria-live="polite">The first call raises a flag. The rest see: already dirty.</p>
        <div class="stats">
          <div class="stat"><span>setState calls</span><b id="b-calls">0</b></div>
          <div class="stat"><span>build() runs</span><b id="b-builds">0</b></div>
        </div>
        <div class="ctl"><button class="btn yellow" id="b-go" type="button">Call it 5 times</button></div>
        <Flow label="Five calls, one build" items={[{ t: 'setState() x5', c: 'y' }, { t: '1st: mark dirty', c: 'y' }, { t: '2nd to 5th: already dirty', c: 'n' }, { t: 'next frame', c: 'n' }, { t: 'build() x1', c: 'g' }]} />
        <Src links={[{ label: 'setState (idempotent)', href: 'https://api.flutter.dev/flutter/widgets/State/setState.html' }, { label: 'markNeedsBuild', href: 'https://api.flutter.dev/flutter/widgets/Element/markNeedsBuild.html' }]} />
      </div>
      <div class="scene">
        <svg viewBox="0 0 900 680" role="img" aria-label="Five setState calls fall into one dirty list, then one frame runs build once">
          <text x="450" y="268" text-anchor="middle" font-size="26" font-weight="900" fill="#53557E">dirty list</text>
          <rect x="240" y="286" width="420" height="140" rx="30" fill="#F3F4FF" stroke="#1A1B3A" stroke-width="4" />
          <g id="b-flag" transform="translate(268 304)"><g fill="none" stroke="#1A1B3A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" transform="scale(1.5)" set:html={inner(flag)} /></g>
          <g id="b-tag" opacity="0"><rect x="-96" y="-26" width="192" height="52" rx="16" fill="#FFC93C" stroke="#1A1B3A" stroke-width="3" /><text class="mono" y="7" text-anchor="middle" font-size="20" font-weight="700">CounterPage</text></g>
          {
            [0, 1, 2, 3, 4].map((i) => (
              <g class="chip" data-i={i} opacity="0">
                <rect x="-74" y="-27" width="148" height="54" rx="18" fill="#FFC93C" stroke="#1A1B3A" stroke-width="3" />
                <text class="mono" y="7" text-anchor="middle" font-size="19" font-weight="700">setState()</text>
              </g>
            ))
          }
          <g id="b-late">
            {[1, 2, 3, 4].map((i) => <text class="late" data-i={i} x={150 + i * 150} y="238" text-anchor="middle" font-size="19" font-weight="900" fill="#d63a3a" opacity="0">already dirty</text>)}
          </g>
          <text x="450" y="500" text-anchor="middle" font-size="24" font-weight="900" fill="#53557E">next frame</text>
          <rect x="150" y="516" width="600" height="38" rx="19" fill="#F3F4FF" stroke="#1A1B3A" stroke-width="4" />
          <rect id="b-fill" x="154" y="520" width="0" height="30" rx="15" fill="#5B7CFF" />
          <g id="b-done" opacity="0" transform="translate(450 625)">
            <g transform="translate(-170 -28) scale(1.8)" fill="none" stroke="#1A1B3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={inner(hammer)} />
            <text x="-110" y="12" font-size="46" font-weight="900" fill="#1A1B3A">build() ran once</text>
          </g>
        </svg>
      </div>
    </section>

    <!-- 5 · Compare -->
    <section class="act" id="act-5" data-label="Compare" aria-label="Compare">
      <div class="panel">
        <p class="kick"><i>6</i>The key step</p>
        <h2><em>Reuse</em> or <em>recreate</em>?</h2>
        <div class="explain"><b>In simple words</b><p>After build(), Flutter holds a new widget. It checks it against the old one. Same widget: do nothing. Same type and key: keep the Element and update it. Different: a new Element, and the old State is lost.</p><p class="think"><i>Like a restaurant:</i> same dish and same table number: the waiter stays and reads the new slip. Different dish: a new waiter starts, and the old table notes are gone.</p></div>
        <p class="cap" id="c-cap">Pick a new widget:</p>
        <div class="seg">
          <button class="btn" id="c-skip" type="button">const (same object)</button>
          <button class="btn" id="c-reuse" type="button">Same type</button>
          <button class="btn warn" id="c-recreate" type="button">Different type</button>
        </div>
        <div class="result" id="c-result"><b>Result</b><p>Pick one.</p></div>
<svg class="chart" id="c-chart" viewBox="0 0 340 256" role="img" aria-label="Flow chart: new widget. Same object? yes: skip. No: same type and key? yes: reuse the Element. No: recreate it.">
          <defs><marker id="ch-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#1A1B3A" /></marker></defs>
          <g class="ln" id="ch-l0"><path d="M110 32 V54" /></g>
          <g class="ln" id="ch-l1y"><path d="M172 80 H204" /></g>
          <g class="ln" id="ch-l1n"><path d="M110 104 V132" /></g>
          <g class="ln" id="ch-l2y"><path d="M172 158 H204" /></g>
          <g class="ln" id="ch-l2n"><path d="M110 182 V208" /></g>
          <rect class="nd" id="ch-start" x="48" y="4" width="124" height="28" rx="14" />
          <text x="110" y="23" text-anchor="middle">new widget</text>
          <path class="nd" id="ch-q1" d="M110 56 L172 80 L110 104 L48 80Z" />
          <text x="110" y="78" text-anchor="middle">same</text><text x="110" y="92" text-anchor="middle">object?</text>
          <path class="nd" id="ch-q2" d="M110 134 L172 158 L110 182 L48 158Z" />
          <text x="110" y="156" text-anchor="middle">same type</text><text x="110" y="170" text-anchor="middle">+ key?</text>
          <rect class="nd o-skip" id="ch-skip" x="206" y="62" width="128" height="36" rx="10" />
          <text x="270" y="85" text-anchor="middle">SKIP</text>
          <rect class="nd o-reuse" id="ch-reuse" x="206" y="140" width="128" height="36" rx="10" />
          <text x="270" y="163" text-anchor="middle">REUSE</text>
          <rect class="nd o-recreate" id="ch-recreate" x="48" y="210" width="124" height="36" rx="10" />
          <text x="110" y="233" text-anchor="middle">RECREATE</text>
          <text class="yn" x="188" y="72" text-anchor="middle">yes</text>
          <text class="yn" x="124" y="122">no</text>
          <text class="yn" x="188" y="150" text-anchor="middle">yes</text>
          <text class="yn" x="124" y="200">no</text>
        </svg>
        <Src links={[{ label: 'updateChild', href: 'https://api.flutter.dev/flutter/widgets/Element/updateChild.html' }, { label: 'Widget.canUpdate', href: 'https://api.flutter.dev/flutter/widgets/Widget/canUpdate.html' }]} />
      </div>
      <div class="scene">
        <svg viewBox="0 0 900 680" role="img" aria-label="A mascot called Element compares an old widget with a new widget">
          <rect x="290" y="520" width="320" height="26" rx="12" fill="#5B7CFF" stroke="#1A1B3A" stroke-width="4" />
          <rect x="316" y="546" width="18" height="70" fill="#3E5AD6" stroke="#1A1B3A" stroke-width="3" />
          <rect x="566" y="546" width="18" height="70" fill="#3E5AD6" stroke="#1A1B3A" stroke-width="3" />
          <text x="450" y="648" text-anchor="middle" font-size="26" font-weight="900" fill="#53557E">Element</text>
          <text x="200" y="418" text-anchor="middle" font-size="24" font-weight="900" fill="#53557E">widget</text>
          <text x="765" y="540" text-anchor="middle" font-size="24" font-weight="900" fill="#53557E">RenderObject</text>

          <g id="c-old">
            <rect x="-110" y="-46" width="220" height="92" rx="20" fill="#5B7CFF" stroke="#1A1B3A" stroke-width="4" />
            <text id="c-old-t" class="mono" y="9" text-anchor="middle" font-size="28" font-weight="700" fill="#fff">Text('5')</text>
          </g>
          <g id="c-new" opacity="0">
            <rect id="c-new-r" x="-110" y="-46" width="220" height="92" rx="20" fill="#5B7CFF" stroke="#1A1B3A" stroke-width="4" />
