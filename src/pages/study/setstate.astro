          <Flow
            label="Memory trick"
            steps={[
              { t: 'Mark', s: 'flag + list', c: 'amber' },
              { t: 'Wait', s: 'next frame', c: 'violet' },
              { t: 'Build', s: 'dirty only', c: 'blue' },
