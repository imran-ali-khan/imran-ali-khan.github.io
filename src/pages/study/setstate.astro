    <footer class="deck-bottom">
      <button class="nav-btn" id="prev" type="button" aria-label="Previous">&larr; Back</button>
      <div class="progress">
        <div class="bar"><i id="bar"></i></div>
        <div class="meta"><span id="count">1 / 19</span><span class="hint" id="hint">Use &larr; &rarr; or swipe</span></div>
      </div>
      <button class="nav-btn primary" id="next" type="button" aria-label="Next">Next &rarr;</button>
    </footer>
  </div>

  <script>
    // ---------------------------------------------------------------
    // Deck: 3D slides, steps inside a slide, chapters, keyboard, swipe.
    // ---------------------------------------------------------------
    const deck = document.getElementById('deck') as HTMLElement;
    const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
    const total = slides.length;
    const bar = document.getElementById('bar') as HTMLElement;
    const countEl = document.getElementById('count') as HTMLElement;
    const hintEl = document.getElementById('hint') as HTMLElement;
    const prevBtn = document.getElementById('prev') as HTMLButtonElement;
    const nextBtn = document.getElementById('next') as HTMLButtonElement;
    const chapterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-chapter-btn]'));

    const stepsOf = (i: number) =>
      Array.from(slides[i].querySelectorAll<HTMLElement>('[data-step]'));
    const maxStep = (i: number) => stepsOf(i).reduce((m, el) => Math.max(m, Number(el.dataset.step)), 0);

    let cur = 0;
    let step = 0;

    function applySteps() {
      stepsOf(cur).forEach((el) => el.classList.toggle('on', Number(el.dataset.step) <= step));
    }

    function render() {
      slides.forEach((s, i) => {
        const o = i - cur;
        const a = Math.abs(o);
        s.style.setProperty('--o', String(Math.max(-2, Math.min(2, o))));
        s.style.setProperty('--a', String(Math.min(a, 2)));
        s.classList.toggle('is-active', a === 0);
        s.classList.toggle('near', a === 1);
        s.toggleAttribute('inert', a !== 0);
        s.setAttribute('aria-hidden', a === 0 ? 'false' : 'true');
        if (a !== 0) s.querySelectorAll('[data-step]').forEach((el) => el.classList.remove('on'));
      });
      applySteps();

      const chapter = slides[cur].dataset.chapter;
      chapterBtns.forEach((b) => b.setAttribute('aria-current', String(b.dataset.chapterBtn === chapter)));
      // Scroll only the chapter bar (scrollIntoView would also scroll the whole deck sideways).
      const activeBtn = chapterBtns.find((b) => b.dataset.chapterBtn === chapter);
      const bar2 = activeBtn?.parentElement;
      if (activeBtn && bar2) bar2.scrollLeft = activeBtn.offsetLeft - (bar2.clientWidth - activeBtn.offsetWidth) / 2;

      const ms = maxStep(cur);
      bar.style.width = `${((cur + (ms ? step / ms : 1)) / total) * 100}%`;
      countEl.textContent = `${cur + 1} / ${total}`;
      hintEl.textContent = ms && step < ms ? `Step ${step} of ${ms}. Press next to continue` : 'Use ← → or swipe';
      prevBtn.disabled = cur === 0 && step === 0;
      nextBtn.disabled = cur === total - 1 && step >= ms;
      nextBtn.innerHTML = ms && step < ms ? 'Next step &darr;' : cur === total - 1 ? 'The end' : 'Next &rarr;';

      history.replaceState(null, '', `#${cur + 1}`);
      slides[cur].dispatchEvent(new CustomEvent('slideenter'));
    }

    function goTo(i: number, s = 0) {
      cur = Math.max(0, Math.min(total - 1, i));
      step = s;
      render();
    }
    function next() {
      if (step < maxStep(cur)) {
        step++;
        applySteps();
        // refresh bar / hint without re-triggering the slide
        const ms = maxStep(cur);
        bar.style.width = `${((cur + (ms ? step / ms : 1)) / total) * 100}%`;
        hintEl.textContent = step < ms ? `Step ${step} of ${ms}. Press next to continue` : 'Use ← → or swipe';
        nextBtn.innerHTML = step < ms ? 'Next step &darr;' : cur === total - 1 ? 'The end' : 'Next &rarr;';
        nextBtn.disabled = cur === total - 1 && step >= ms;
        prevBtn.disabled = false;
      } else if (cur < total - 1) {
        goTo(cur + 1, 0);
      }
    }
    function prev() {
      if (step > 0) {
        step--;
        applySteps();
        const ms = maxStep(cur);
        bar.style.width = `${((cur + (ms ? step / ms : 1)) / total) * 100}%`;
        hintEl.textContent = `Step ${step} of ${ms}. Press next to continue`;
        nextBtn.innerHTML = 'Next step &darr;';
        nextBtn.disabled = false;
        prevBtn.disabled = cur === 0 && step === 0;
      } else if (cur > 0) {
        goTo(cur - 1, maxStep(cur - 1));
      }
    }

    nextBtn.addEventListener('click', next);
    prevBtn.addEventListener('click', prev);
    chapterBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const i = slides.findIndex((s) => s.dataset.chapter === b.dataset.chapterBtn);
        if (i >= 0) goTo(i, 0);
      })
    );

    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === 'ArrowRight' || e.key === 'PageDown' || (e.key === ' ' && t.tagName !== 'BUTTON')) {
        e.preventDefault();
        next();
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        prev();
      } else if (e.key === 'Home') {
        goTo(0);
      } else if (e.key === 'End') {
        goTo(total - 1, 0);
      }
    });

    // Swipe left/right on touch screens.
    let sx = 0;
    let sy = 0;
    let swipeOK = false;
    const stage = document.getElementById('stage') as HTMLElement;
    stage.addEventListener('pointerdown', (e) => {
      const t = e.target as HTMLElement;
      swipeOK = e.pointerType === 'touch' && !t.closest('button, input, label, pre, .log');
      sx = e.clientX;
      sy = e.clientY;
    });
    stage.addEventListener('pointerup', (e) => {
      if (!swipeOK) return;
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) (dx < 0 ? next : prev)();
      swipeOK = false;
    });

    // Start from the link: #6 or #6.2 (slide 6, step 2).
    const m = location.hash.match(/^#(\d+)(?:\.(\d+))?$/);
    const startSlide = m ? Math.max(0, Math.min(total - 1, Number(m[1]) - 1)) : 0;
    cur = startSlide;
    step = m && m[2] ? Math.min(Number(m[2]), maxStep(startSlide)) : 0;
    render();
    // Wait one frame before enabling the heavy transitions so the first paint is clean.
    requestAnimationFrame(() => deck.classList.add('ready'));

    const onEnter = (id: string, fn: () => void) => {
      const el = document.getElementById(id)?.closest<HTMLElement>('.slide');
      el?.addEventListener('slideenter', fn);
    };
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const addLog = (ul: HTMLElement, text: string, kind: string) => {
      const li = document.createElement('li');
      li.className = `k-${kind}`;
      li.textContent = text;
      ul.appendChild(li);
      ul.scrollTop = ul.scrollHeight;
    };

    // ---------------------------------------------------------------
    // Demo 1 (slide 2): without vs with setState
    // ---------------------------------------------------------------
    {
      let a = 0;
      let b = 0;
      const pop = (el: HTMLElement) => {
        el.classList.remove('pop');
        void el.offsetWidth;
        el.classList.add('pop');
      };
      $('why-a-btn').addEventListener('click', () => {
        a++;
        $('why-a-var').textContent = String(a); // the variable changes, the screen does not
      });
      $('why-b-btn').addEventListener('click', () => {
        b++;
        $('why-b-var').textContent = String(b);
        $('why-b-screen').textContent = String(b);
        pop($('why-b-screen'));
      });
    }

    // ---------------------------------------------------------------
    // Demo 2 (slide 5): dirty flag and batching
    // ---------------------------------------------------------------
    {
      const log = $('batch-log');
      let calls = 0;
      let builds = 0;
      let scheduled = false;
      const FRAME_MS = 1800; // slowed down so you can see it

      const setCalls = () => ($('batch-calls').textContent = String(calls));
      function schedule() {
        scheduled = true;
        $('batch-dirty').innerHTML = '<span class="ditem">CounterPage</span>';
        $('batch-frame').textContent = 'Frame scheduled. Waiting for the next VSync (slowed down for you)...';
        const t0 = performance.now();
        const timer = window.setInterval(() => {
          const p = Math.min(1, (performance.now() - t0) / FRAME_MS);
          $('batch-bar').style.width = `${p * 100}%`;
          if (p >= 1) {
            clearInterval(timer);
            frame();
          }
        }, 40);
      }
      function frame() {
        builds++;
        $('batch-builds').textContent = String(builds);
        $('batch-builds').classList.remove('flash');
        void $('batch-builds').offsetWidth;
        $('batch-builds').classList.add('flash');
        addLog(log, `FRAME: buildScope() --> CounterPage.build() runs ONCE (for ${calls} call${calls === 1 ? '' : 's'})`, 'blue');
        calls = 0;
        setCalls();
        scheduled = false;
        $('batch-dirty').innerHTML = '<span class="empty">Empty. Nothing to rebuild.</span>';
        $('batch-bar').style.width = '0';
        $('batch-frame').textContent = 'Frame done. Idle again.';
      }
      function call() {
        calls++;
        setCalls();
        if (!scheduled) {
          addLog(log, 'setState() --> markNeedsBuild() --> added to dirty list, frame requested', 'amber');
          schedule();
        } else {
          addLog(log, 'setState() --> already dirty, nothing to do', 'slate');
        }
      }
      $('batch-call').addEventListener('click', call);
      $('batch-five').addEventListener('click', () => {
        for (let i = 0; i < 5; i++) call();
      });
      onEnter('demo-batch', () => {
        if (!log.children.length) addLog(log, 'Press "Call setState()" to start.', 'slate');
      });
    }

    // ---------------------------------------------------------------
    // Demo 3 (slide 12): which Elements are rebuilt?
    // ---------------------------------------------------------------
    {
      const tree = $('tree');
      const items = Array.from(tree.querySelectorAll<HTMLElement>('li[data-n]'));
      const byId = new Map(items.map((li) => [li.dataset.n as string, li]));
      const nameOf = (li: HTMLElement) => (li.querySelector('.tn')?.firstChild?.textContent || '').trim();
      const kids = (li: HTMLElement) => Array.from(li.querySelectorAll<HTMLElement>(':scope > ul > li'));
      const log = $('tree-log');
      let owner: 'home' | 'cbox' = 'home';
      let timers: number[] = [];

      function reset() {
        timers.forEach(clearTimeout);
        timers = [];
        items.forEach((li) => li.removeAttribute('data-status'));
        log.innerHTML = '';
        ['tree-n-rebuilt', 'tree-n-skipped', 'tree-n-untouched'].forEach((id) => ($(id).textContent = '0'));
        $('tree-verdict').textContent = 'Press the button to see what happens.';
      }
      function markOwner() {
        items.forEach((li) => li.setAttribute('data-owner', String(li.dataset.n === owner)));
      }
      function setConstLabels() {
        const on = ($('tree-const') as HTMLInputElement).checked;
        items.forEach((li) => {
          if (li.dataset.canconst) {
            const s = li.querySelector('small');
            if (s) s.textContent = on ? 'const' : '';
          }
        });
      }

      function run() {
        reset();
        const constOn = ($('tree-const') as HTMLInputElement).checked;
        const seq: { li: HTMLElement; status: string; msg: string; kind: string }[] = [];
        const rootLi = byId.get(owner) as HTMLElement;
        const rootName = nameOf(rootLi);
        seq.push({
          li: rootLi,
          status: 'source',
          msg: `${rootName} calls setState() --> its Element is dirty --> next frame: ${rootName}.build() runs`,
          kind: 'amber',
        });
        const touched = new Set<HTMLElement>([rootLi]);
        const skipped = new Set<HTMLElement>();
        const visit = (li: HTMLElement) => {
          kids(li).forEach((k) => {
            const name = nameOf(k);
            if (constOn && k.dataset.canconst) {
              skipped.add(k);
              seq.push({
                li: k,
                status: 'skipped',
                msg: `${name}: const, same object --> identical --> SKIPPED (no build)`,
                kind: 'slate',
              });
              return;
            }
            touched.add(k);
            const extra = name === 'Column' ? ' (a render widget has no build(): its Element is just updated)' : ' --> build() runs';
            seq.push({
              li: k,
              status: 'rebuilt',
              msg: `${name}: new widget, same type and key --> canUpdate --> Element reused${extra}`,
              kind: 'blue',
            });
            visit(k);
          });
        };
        visit(rootLi);

        const untouched = items.filter((li) => !touched.has(li) && !skipped.has(li));
        seq.forEach((s, i) => {
          timers.push(
            window.setTimeout(() => {
              s.li.setAttribute('data-status', s.status);
              addLog(log, s.msg, s.kind);
            }, 350 * i)
          );
        });
        timers.push(
          window.setTimeout(() => {
            untouched.forEach((li) => li.setAttribute('data-status', 'untouched'));
            $('tree-n-rebuilt').textContent = String(touched.size);
            $('tree-n-skipped').textContent = String(skipped.size);
            $('tree-n-untouched').textContent = String(untouched.length);
            addLog(
              log,
              `Not touched: ${untouched.map(nameOf).join(', ')}`,
              'slate'
            );
            const v = $('tree-verdict');
            if (owner === 'home') {
              v.innerHTML =
                `<b>Not the whole app.</b> MyApp and MaterialApp were never touched. ` +
                `Only the subtree under HomePage was rebuilt` +
                (skipped.size ? `, and the const widgets were skipped.` : `. Try the const checkbox to cut more.`);
            } else {
              v.innerHTML =
                `<b>Just ${touched.size} Elements.</b> HomePage, Header and Footer did not even run build(). ` +
                `That is why a small StatefulWidget is cheaper than one big one.`;
            }
          }, 350 * seq.length + 150)
        );
      }

      function choose(which: 'home' | 'cbox') {
        owner = which;
        $('tree-a').setAttribute('aria-pressed', String(which === 'home'));
        $('tree-b').setAttribute('aria-pressed', String(which === 'cbox'));
        markOwner();
        run();
      }
      $('tree-a').addEventListener('click', () => choose('home'));
      $('tree-b').addEventListener('click', () => choose('cbox'));
      $('tree-run').addEventListener('click', run);
      $('tree-const').addEventListener('change', () => {
        setConstLabels();
        run();
      });
      markOwner();
      onEnter('demo-tree', () => {
        setConstLabels();
        reset();
        // Show one run by itself, after the slide has flown in.
        timers.push(window.setTimeout(run, 1000));
      });
    }

    // ---------------------------------------------------------------
    // Demo 4 (slide 15): same Element or a new one?
    // ---------------------------------------------------------------
    {
      const log = $('el-log');
      let widgetNo = 1;
      let elementNo = 1;
      let taps = 0;
      let kind = 'Text';
      let key = 1;
      let builds = 0;
      let created = 1;
      let disposed = 0;

      const flash = (id: string) => {
        const el = $(id);
        el.classList.remove('pulse');
        void el.offsetWidth;
        el.classList.add('pulse');
      };
      function paint() {
        $('el-widget-val').textContent = `${kind}#${widgetNo}`;
        $('el-widget-sub').textContent = `type: ${kind}, key: ValueKey(${key})`;
        $('el-element-val').textContent = `Element E${elementNo}`;
        $('el-state-val').textContent = `taps = ${taps}`;
        $('el-builds').textContent = String(builds);
        $('el-created').textContent = String(created);
        $('el-disposed').textContent = String(disposed);
      }
      function recreate(why: string) {
        widgetNo++;
        builds++;
        const old = elementNo;
        elementNo++;
        created++;
        disposed++;
        taps = 0;
        paint();
        flash('el-widget');
        flash('el-element');
        flash('el-state');
        addLog(log, `${why} --> canUpdate = false`, 'rose');
        addLog(log, `Old Element E${old} disposed (State lost). New Element E${elementNo} created, taps = 0`, 'rose');
      }

      $('el-tap').addEventListener('click', () => {
        taps++;
        builds++;
        paint();
        flash('el-state');
        addLog(log, `setState() inside the State --> build() runs. Widget and Element unchanged, taps = ${taps}`, 'amber');
      });
      $('el-rebuild').addEventListener('click', () => {
        widgetNo++;
        builds++;
        paint();
        flash('el-widget');
        addLog(log, `Parent rebuilt --> new widget (#${widgetNo}), same type and key --> Element E${elementNo} REUSED, State kept (taps = ${taps})`, 'blue');
      });
      $('el-const').addEventListener('click', () => {
        addLog(log, `const widget --> identical(old, new) --> SKIPPED. build() did not run at all`, 'slate');
      });
      $('el-type').addEventListener('click', () => {
        kind = kind === 'Text' ? 'Icon' : 'Text';
        recreate(`Type changed (${kind === 'Icon' ? 'Text to Icon' : 'Icon to Text'})`);
      });
      $('el-key').addEventListener('click', () => {
        key++;
        recreate(`Key changed to ValueKey(${key})`);
      });
      onEnter('demo-el', () => {
        if (!log.children.length) addLog(log, 'Tap a few times, then try the buttons.', 'slate');
      });
    }

    // ---------------------------------------------------------------
    // Demo 5 (slide 16): why keys matter
    // ---------------------------------------------------------------
    {
      type Item = { name: string; key: string };
      const items: Item[] = [
        { name: 'Ali', key: 'ali' },
        { name: 'Sara', key: 'sara' },
      ];
      // The colors live in each Element's State, created for the first order.
      const elements = [
        { key: 'ali', color: '#fb7185', label: 'rose' },
        { key: 'sara', color: '#34d399', label: 'green' },
      ];
      let order: Item[] = items.slice();
      const useKeys = $('keys-use') as HTMLInputElement;

      const chip = (text: string, color?: string, cls = '') => {
        const s = document.createElement('span');
        s.className = `kchip ${cls}`;
        s.textContent = text;
        if (color) s.style.setProperty('--c', color);
        return s;
      };

      function paint() {
        const w = $('keys-w');
        const e = $('keys-e');
        const r = $('keys-r');
        w.innerHTML = '';
        e.innerHTML = '';
        r.innerHTML = '';
        order.forEach((it) => w.appendChild(chip(it.name, '#38bdf8')));
        elements.forEach((el, i) => e.appendChild(chip(`E${i + 1} (${el.label})`, el.color)));

        let allGood = true;
        order.forEach((it, pos) => {
          // With keys, Flutter finds the Element by key. Without keys, it matches by position.
          const el = useKeys.checked ? elements.find((x) => x.key === it.key)! : elements[pos];
          const good = el.key === it.key;
          if (!good) allGood = false;
          r.appendChild(chip(`${it.name} + ${el.label}`, el.color, `res ${good ? 'good' : 'bad'}`));
        });
        const orderChanged = order[0].key !== items[0].key;
        $('keys-note').textContent = !orderChanged
          ? 'Each tile shows a name (from the widget) and a color (from the State). Press swap.'
          : allGood
          ? 'Correct. With keys, each Element follows its own widget, so the colors moved with the names.'
          : 'Wrong. The names moved, but the colors stayed in place. The State stayed at its old position.';
      }
      $('keys-swap').addEventListener('click', () => {
        order = order.slice().reverse();
        paint();
      });
      useKeys.addEventListener('change', paint);
      paint();
    }

    // ---------------------------------------------------------------
    // Copy button (last slide)
    // ---------------------------------------------------------------
    // The demos above listen for "slideenter". Send it once now for the slide we started on.
    slides[cur].dispatchEvent(new CustomEvent('slideenter'));

    $('copy-speech').addEventListener('click', async () => {
      const text = Array.from(document.querySelectorAll('#speech p'))
        .map((p) => p.textContent)
        .join('\n\n');
      try {
        await navigator.clipboard.writeText(text);
        $('copy-note').textContent = 'Copied.';
      } catch {
        $('copy-note').textContent = 'Could not copy. Select the text and copy it.';
      }
    });
  </script>
</StudyLayout>
