---
import StudyLayout from '@/layouts/StudyLayout.astro';
import Slide from '@/components/study/Slide.astro';
import Flow from '@/components/study/Flow.astro';
import CodeBox from '@/components/study/CodeBox.astro';
import Iso from '@/components/study/Iso.astro';
import { seriesName } from '@/data/study';
import '@/styles/study.css';

const base = import.meta.env.BASE_URL;

const codeBug = `int count = 0;

onPressed: () {
  count++;   // the variable changed in memory
}            // but the screen? Still shows the old number`;

const codeSetState = `void setState(VoidCallback fn) {
  fn();                        // 1. run your change right now
  _element!.markNeedsBuild();  // 2. raise a flag: "I need a new build()"
}`;

const codeBatch = `setState(() => a++);
setState(() => b++);
setState(() => c++);
// 3 calls, but only ONE build() in the next frame`;

const codeMark = `// inside Element (simplified)
void markNeedsBuild() {
  if (!_active) return;            // not in the tree? ignore
  if (_dirty) return;              // already marked? ignore
  _dirty = true;                   // raise the flag
  owner!.scheduleBuildFor(this);   // join the to-do list
}`;

const codeOwner = `// inside BuildOwner, the manager of all rebuilds (simplified)
void scheduleBuildFor(Element e) {
  if (!_scheduledFlushDirtyElements) {
    onBuildScheduled();        // first dirty element: ask for a new frame
  }
  _dirtyElements.add(e);       // add to the dirty list
}`;

const codeDraw = `// WidgetsBinding.drawFrame (simplified)
void drawFrame() {
  buildOwner.buildScope(rootElement);  // BUILD: run the dirty rebuilds
  super.drawFrame();                   // LAYOUT, PAINT, COMPOSITE
  buildOwner.finalizeTree();           // clean up Elements that were removed
}`;

const codeScope = `// BuildOwner.buildScope (simplified)
void buildScope(Element root) {
  _dirtyElements.sort(Element._sort);  // shallow elements (parents) first
  for (final e in _dirtyElements) {
    e.rebuild();                       // this ends in your build()
  }
  _dirtyElements.clear();
}`;

const codeUpdate = `// Element.updateChild (simplified)
Element? updateChild(Element? child, Widget? newWidget) {
  if (child != null) {
    if (identical(child.widget, newWidget)) return child;  // 1. same object: skip
    if (Widget.canUpdate(child.widget, newWidget)) {       // 2. same type + key
      child.update(newWidget);                             //    reuse the Element
      return child;
    }
    deactivateChild(child);                                // 3. drop the old Element
  }
  return inflateWidget(newWidget);                         //    create a new Element
}`;

const codeConst = `class HomePage extends StatefulWidget { /* ... */ }

// inside HomePage's State
Widget build(BuildContext context) {
  return Column(children: [
    const Header(),        // same object every time: skipped
    CounterBox(),          // new object each time: Element reused, rebuilt
    const Footer(),        // skipped
  ]);
}`;

const codeLife = `createState()   // once, when the Element is born
initState()     // once
build()         // MANY times (every setState, every parent rebuild)
didUpdateWidget() // when the parent hands this Element a NEW widget
dispose()       // once, when the Element dies`;

const interview = `When I call setState, Flutter runs my callback and marks that widget's Element as dirty. The Element adds itself to the BuildOwner's dirty list and schedules a frame. Nothing is built yet.

In the next frame, Flutter calls build() only for the dirty Elements, parents first. Each build returns new Widget objects. They are cheap, short-lived descriptions.

Then updateChild compares old and new. If it is the same object, like a const widget, it is skipped. If the type and key match, the Element is reused and updated with the new widget. If not, the old Element is thrown away and a new one is created, so the State is lost.

So only the subtree under that State is rebuilt, not the whole app. RenderObjects are updated only when a value really changed, so layout and paint stay small.`;

const chapters = ['Start', 'Why', 'What', 'How', 'Where', 'Element', 'Recap'];
---

<StudyLayout
  title="setState() explained visually | Flutter Under the Hood"
  description="A step by step visual guide to what happens inside Flutter when you call setState()."
>
  <div class="deck" id="deck" data-total="19">
    <header class="deck-top">
      <a class="back" href={`${base}study/`}>&larr; Study</a>
      <span class="series">{seriesName} &middot; Episode 1</span>
      <nav class="chapters" aria-label="Chapters">
        {chapters.map((c) => <button type="button" data-chapter-btn={c}>{c}</button>)}
      </nav>
    </header>

    <div class="stage" id="stage">
      <!-- 0 ------------------------------------------------------------ -->
      <section class="slide" data-chapter="Start" aria-roledescription="slide" aria-label="1. Title">
        <div class="slide-in">
          <div class="cols c2" style="align-items:center">
            <div class="sh">
              <p class="kick"><span class="chip">Episode 1</span><span class="kick-text">{seriesName}</span></p>
              <h1>
                What really happens when you call <span class="text-gradient">setState()</span>?
              </h1>
              <p class="lead">
                A visual, step by step guide. We start with the very first idea and end with what Flutter does inside,
                in the simplest words.
              </p>
              <div class="mt-6 grid gap-3">
                <div class="card tint" style="--c:#38bdf8">
                  <h3>Question 1</h3>
                  <p>What exactly triggers a rebuild, and which parts of the widget tree get rebuilt?</p>
                </div>
                <div class="card tint" style="--c:#a78bfa">
                  <h3>Question 2</h3>
                  <p>
                    Does <code class="i">setState()</code> rebuild the whole app, the whole screen, or only one subtree? And
                    what is the difference between <code class="i">build()</code> being called and an Element being
                    recreated?
                  </p>
                </div>
              </div>
              <p class="mt-5 text-sm muted">
                Press <span class="ic">&rarr;</span> or tap <b>Next</b>. Some slides have extra steps and buttons to play with.
              </p>
            </div>
            <Iso />
          </div>
        </div>
      </section>

      <!-- 1 WHY ------------------------------------------------------- -->
      <Slide
        n={2}
        chapter="Why"
        kicker="The problem"
        title="Why does setState() exist?"
        lead="In Flutter, a widget never changes after it is created. It is like a printed photo. To show something new, Flutter needs a new photo."
      >
        <div class="cols c2">
          <div data-step="1">
            <CodeBox code={codeBug} label="The mistake every beginner makes" />
            <div class="takeaway bad">
              Changing a variable only changes memory. Flutter does not watch your variables, so nobody tells it to redraw.
            </div>
          </div>
          <div data-step="2">
            <div class="phones" id="demo-why">
              <div class="phone-col">
                <h4 class="text-ink-100">Without setState</h4>
                <div class="phone"><span class="big" id="why-a-screen">0</span></div>
                <span class="pill">count = <b id="why-a-var">0</b></span>
                <button class="btn-g" id="why-a-btn" type="button">count++</button>
              </div>
              <div class="phone-col">
                <h4 class="text-ink-100">With setState</h4>
                <div class="phone"><span class="big" id="why-b-screen">0</span></div>
                <span class="pill">count = <b id="why-b-var">0</b></span>
                <button class="btn-s" id="why-b-btn" type="button">setState(count++)</button>
              </div>
            </div>
            <p class="mt-3 text-center text-xs muted">Try both buttons. The left screen never updates.</p>
          </div>
        </div>
        <div class="mt-5 grid gap-3" data-step="3">
          <Flow
            label="Without setState"
            steps={[
              { t: 'count++', c: 'slate' },
              { t: 'variable changes', c: 'slate' },
              { t: 'nobody tells Flutter', c: 'rose' },
              { t: 'screen stays old', c: 'rose' },
            ]}
          />
          <Flow
            label="With setState"
            steps={[
              { t: 'setState(() => count++)', c: 'amber' },
              { t: 'variable changes', c: 'slate' },
              { t: 'Flutter is told', c: 'blue' },
              { t: 'new screen drawn', c: 'green' },
            ]}
          />
        </div>
        <div class="takeaway note" data-step="3">
          Think of it as <b>UI = f(state)</b>. The screen is just the result of your data. setState says: "my data changed,
          please draw the result again."
        </div>
      </Slide>

      <!-- 2 WHY ------------------------------------------------------- -->
      <Slide
        n={3}
        chapter="Why"
        kicker="The big picture"
        title="Flutter keeps three trees"
        lead="To redraw fast, Flutter splits the job into three parts. If you understand these three, everything else in this lesson becomes easy."
      >
        <div class="cols c-wide-right" style="align-items:center">
          <Iso compact />
          <div class="grid gap-3">
            <div class="card tint" style="--c:#38bdf8" data-step="1">
              <h3><span class="dot-c"></span>Widget tree: the blueprint</h3>
              <p>
                A tiny, read-only description. "A Text that says 5." Very cheap. Flutter creates and throws away thousands of
                them all the time.
              </p>
            </div>
            <div class="card tint" style="--c:#a78bfa" data-step="2">
              <h3><span class="dot-c"></span>Element tree: the site manager</h3>
              <p>
                Lives for a long time. Knows where each widget sits, <b>holds your State object</b>, and connects the widget to
                the RenderObject.
              </p>
            </div>
            <div class="card tint" style="--c:#34d399" data-step="3">
              <h3><span class="dot-c"></span>RenderObject tree: the worker</h3>
              <p>
                Does the real job: measures sizes (layout) and draws pixels (paint). This is the expensive part, so Flutter
                reuses it as much as it can.
              </p>
            </div>
          </div>
        </div>
        <div class="mt-5" data-step="4">
          <Flow
            steps={[
              { t: 'Widget', s: 'what to show', c: 'blue' },
              { t: 'Element', s: 'who and where (keeps State)', c: 'violet' },
              { t: 'RenderObject', s: 'size and pixels', c: 'green' },
            ]}
          />
        </div>
      </Slide>

      <!-- 3 WHAT ------------------------------------------------------ -->
      <Slide
        n={4}
        chapter="What"
        kicker="Inside setState"
        title="What is setState(), really?"
        lead="It does only two small things. And notice: it does not rebuild anything by itself."
      >
        <div class="cols c2">
          <div data-step="1">
            <CodeBox code={codeSetState} label="setState, simplified" />
            <p class="mt-3 text-xs muted">
              Simplified. The real version also has safety checks, for example it complains if your callback returns a Future.
            </p>
          </div>
          <div class="grid gap-3">
            <div class="card tint" style="--c:#fbbf24" data-step="2">
              <h3>1. Runs your function, right now</h3>
              <p>
                <code class="i">fn()</code> runs at once, in the same moment. Your variable changes immediately. That is why the
                callback must be normal code, not <code class="i">async</code>.
              </p>
            </div>
            <div class="card tint" style="--c:#a78bfa" data-step="3">
              <h3>2. Marks the Element as dirty</h3>
              <p>
                "Dirty" is just a flag that means: <i>this Element needs a new <code class="i">build()</code></i>. The real
                work happens later, in the next frame.
              </p>
            </div>
          </div>
        </div>
        <div class="mt-5" data-step="4">
          <Flow
            steps={[
              { t: 'setState(fn)', c: 'amber' },
              { t: 'fn() runs now', s: 'variable changes', c: 'slate' },
              { t: 'markNeedsBuild()', c: 'violet' },
              { t: 'Element is dirty', s: 'flag raised', c: 'violet' },
              { t: 'rebuild comes later', s: 'next frame', c: 'blue' },
            ]}
          />
        </div>
      </Slide>

      <!-- 4 WHAT ------------------------------------------------------ -->
      <Slide
        n={5}
        chapter="What"
        kicker="Try it"
        title="Dirty flag and batching"
        lead="Marking an Element dirty is cheap, and you can do it many times. Flutter still rebuilds only once per frame."
      >
        <div class="cols c2" id="demo-batch">
          <div>
            <CodeBox code={codeBatch} label="Three calls in a row" />
            <div class="controls mt-4">
              <button class="btn-s" id="batch-call" type="button">Call setState()</button>
              <button class="btn-g" id="batch-five" type="button">Call it 5 times</button>
            </div>
            <div class="flow-label mt-5">Waiting for the next frame</div>
            <div class="frame-track"><i id="batch-bar"></i></div>
            <p class="frame-label" id="batch-frame">Idle. No frame scheduled.</p>
          </div>
          <div class="grid gap-3">
            <div class="stats">
              <div class="stat"><span>setState calls (this frame)</span><b id="batch-calls">0</b></div>
              <div class="stat"><span>build() runs (total)</span><b id="batch-builds">0</b></div>
            </div>
            <div>
              <p class="flow-label">BuildOwner dirty list</p>
              <div class="dirtybox" id="batch-dirty"><span class="empty">Empty. Nothing to rebuild.</span></div>
            </div>
            <ul class="log" id="batch-log" aria-live="polite"></ul>
          </div>
        </div>
        <div class="takeaway">
          The first call adds the Element to the dirty list and asks for a frame. Every next call sees "already dirty" and
          does nothing. That is why 100 setState calls are not 100 rebuilds.
        </div>
      </Slide>

      <!-- 5 HOW ------------------------------------------------------- -->
      <Slide
        n={6}
        chapter="How"
        kicker="The full journey"
        title="From setState() to pixels, in one view"
        lead="Five steps. Your code runs only in step 1. Flutter does the rest in the next frame. We will open every step next."
      >
        <div class="grid gap-4">
          <div data-step="1">
            <Flow
              label="1  Mark  (right now, in your code)"
              steps={[
                { t: 'setState()', c: 'amber' },
                { t: 'markNeedsBuild()', c: 'violet' },
                { t: 'scheduleBuildFor()', c: 'violet' },
                { t: 'scheduleFrame()', s: 'ask the engine for a frame', c: 'violet' },
              ]}
            />
          </div>
          <div data-step="2">
            <Flow
              label="2  Wait  (until the next VSync, about 16 ms)"
              steps={[
                { t: 'your code keeps running', c: 'slate' },
                { t: 'VSync arrives', c: 'violet' },
                { t: 'drawFrame()', c: 'violet' },
              ]}
            />
          </div>
          <div data-step="3">
            <Flow
              label="3  Build  +  4  Compare"
              steps={[
                { t: 'buildScope()', s: 'dirty elements only', c: 'blue' },
                { t: 'element.rebuild()', c: 'blue' },
                { t: 'build()', s: 'new Widgets', c: 'blue' },
                { t: 'updateChild()', s: 'reuse or recreate', c: 'blue' },
              ]}
            />
          </div>
          <div data-step="4">
            <Flow
              label="5  Draw"
              steps={[
                { t: 'update RenderObject', c: 'green' },
                { t: 'flushLayout', c: 'green' },
                { t: 'flushPaint', c: 'green' },
                { t: 'compositeFrame', c: 'green' },
                { t: 'pixels on screen', c: 'green' },
              ]}
            />
          </div>
        </div>
      </Slide>

      <!-- 6 HOW 1 ----------------------------------------------------- -->
      <Slide
        n={7}
        chapter="How"
        kicker="Step 1 of 5"
        title="Mark: raise the flag, join the list"
        lead="markNeedsBuild() checks two things and then writes the Element's name on a to-do list."
      >
        <div class="cols c2">
          <div class="grid gap-3">
            <div data-step="1"><CodeBox code={codeMark} label="Element" /></div>
            <div data-step="2"><CodeBox code={codeOwner} label="BuildOwner" /></div>
          </div>
          <div class="grid gap-3" data-step="3">
            <Flow
              col
              steps={[
                { t: 'Element._dirty = true', s: 'flag raised', c: 'violet' },
                { t: 'BuildOwner._dirtyElements.add(element)', s: 'name on the to-do list', c: 'violet' },
                { t: 'onBuildScheduled()', s: 'only for the first dirty element', c: 'violet' },
                { t: 'ensureVisualUpdate() / scheduleFrame()', c: 'violet' },
                { t: 'Engine: "call me at the next VSync"', c: 'amber' },
              ]}
            />
          </div>
        </div>
        <div class="takeaway" data-step="4">
          Nothing is built yet. So far there is only one flag and one list entry. That is why setState() itself is so cheap.
        </div>
      </Slide>

      <!-- 7 HOW 2 ----------------------------------------------------- -->
      <Slide
        n={8}
        chapter="How"
        kicker="Step 2 of 5"
        title="Wait: the next frame is the starting gun"
        lead="A screen refreshes at a fixed rhythm: 60 times a second on most phones (every 16.6 ms), 120 on some (every 8.3 ms). Flutter builds once per beat, not once per setState."
      >
        <div class="timeline" data-step="1">
          <span class="mark" style="left:4%">setState() called</span>
          <span class="mark vs" style="left:78%">VSync: frame starts</span>
          <div class="rail">
            <div class="work">your code keeps running (user taps, timers, network...)</div>
            <div class="frame">build + draw</div>
          </div>
          <span class="sweep"></span>
        </div>
        <div class="cols c2 mt-5">
          <div data-step="2">
            <Flow
              col
              label="What the engine does at each beat"
              steps={[
                { t: 'VSync', s: 'screen says: frame time!', c: 'violet' },
                { t: 'onBeginFrame', s: 'animations and tickers move', c: 'slate' },
                { t: 'onDrawFrame', c: 'violet' },
                { t: 'WidgetsBinding.drawFrame()', c: 'blue' },
              ]}
            />
          </div>
          <div data-step="3">
            <CodeBox code={codeDraw} label="drawFrame" />
          </div>
        </div>
        <div class="takeaway" data-step="4">
          This waiting is why many setState calls become one rebuild, and why setState never blocks your code.
        </div>
      </Slide>

      <!-- 8 HOW 3 ----------------------------------------------------- -->
      <Slide
        n={9}
        chapter="How"
        kicker="Step 3 of 5"
        title="Build: only the dirty Elements, parents first"
        lead="buildScope() does not start from the root of the app. It starts from the dirty list."
      >
        <div class="cols c2">
          <div class="grid gap-3">
            <div data-step="1"><CodeBox code={codeScope} label="buildScope" /></div>
            <div data-step="3">
              <div class="grid gap-3">
                <div class="sortrow">
                  <span class="lbl">Dirty list when the frame starts</span>
                  <span class="chipx">CounterBox<small>depth 5</small></span>
                  <span class="chipx">HomePage<small>depth 3</small></span>
                </div>
                <div class="sortrow">
                  <span class="lbl">{'-->'} after sorting by depth</span>
                  <span class="chipx">HomePage<small>depth 3</small></span>
                  <span class="chipx">CounterBox<small>depth 5</small></span>
                </div>
              </div>
            </div>
          </div>
          <div class="grid gap-3" data-step="2">
            <Flow
              col
              steps={[
                { t: 'buildScope()', c: 'blue' },
                { t: 'sort dirty list by depth', s: 'parents first', c: 'amber' },
                { t: 'element.rebuild()', c: 'blue' },
                { t: 'performRebuild()', c: 'blue' },
                { t: 'state.build(context)', s: 'your code runs', c: 'amber' },
                { t: 'returns new Widget(s)', c: 'blue' },
              ]}
            />
          </div>
        </div>
        <div class="takeaway" data-step="4">
          Why parents first? If a parent and its child are both dirty, the parent's build already refreshes the child. When the
          loop reaches the child, it is no longer dirty, so it is not built twice.
        </div>
      </Slide>

      <!-- 9 HOW 4 ----------------------------------------------------- -->
      <Slide
        n={10}
        chapter="How"
        kicker="Step 4 of 5"
        title="Compare: reuse or recreate the Element?"
        lead="build() gave back brand new widgets. For every child spot, Flutter asks two questions. This is the heart of the whole lesson."
      >
        <div class="cols c2">
          <div class="grid gap-3">
            <div class="decide" data-step="1">
              <div class="q">
                <span class="yesno y">Q1</span>Is the new widget the <b>exact same object</b> as the old one? <code>identical(old, new)</code>
              </div>
            </div>
            <div class="decide" data-step="2">
              <div class="q">
                <span class="yesno y">Q2</span>If not: same <b>type</b> and same <b>key</b>? <code>Widget.canUpdate(old, new)</code>
              </div>
            </div>
          </div>
          <div data-step="3"><CodeBox code={codeUpdate} label="updateChild" /></div>
        </div>
        <div class="outs">
          <div class="out" style="--c:#64748b" data-step="1">
            <h4><span class="tag2">Q1 = yes</span>SKIP</h4>
            <p>
              Nothing to do. The Element and everything below it are left alone. This is what <code class="i">const</code> gives you.
            </p>
          </div>
          <div class="out" style="--c:#38bdf8" data-step="2">
            <h4><span class="tag2">Q2 = yes</span>REUSE</h4>
            <p>
              Keep the Element, hand it the new widget (<code class="i">element.update</code>), and it rebuilds. The State survives.
            </p>
          </div>
          <div class="out" style="--c:#fb7185" data-step="3">
            <h4><span class="tag2">Q2 = no</span>RECREATE</h4>
            <p>
              Throw the old Element away (State is disposed) and inflate a new Element with a fresh State.
            </p>
          </div>
        </div>

        <div class="mt-4" data-step="4">
          <Flow
            steps={[
              { t: 'new Widget', c: 'blue' },
              { t: 'identical?', s: 'yes: skip', c: 'slate' },
              { t: 'canUpdate?', s: 'yes: reuse Element', c: 'violet' },
              { t: 'else: new Element', s: 'State lost', c: 'rose' },
            ]}
          />
        </div>
      </Slide>

      <!-- 10 HOW 5 ---------------------------------------------------- -->
      <Slide
        n={11}
        chapter="How"
        kicker="Step 5 of 5"
        title="Draw: only what really changed"
        lead="Reused Elements pass the new settings to their RenderObject. If a value truly changed, the RenderObject asks to be measured or painted again. If not, nothing happens."
      >
        <div class="cols c2">
          <div class="grid gap-3">
            <div class="card tint" style="--c:#34d399" data-step="1">
              <h3>Text('5') becomes Text('6')</h3>
              <p>The text really changed. So the RenderObject says "I need layout and paint". It does both.</p>
              <p class="mt-2 font-mono text-xs" style="color:#6ee7b7">build() ran {'-->'} layout {'-->'} paint {'-->'} new pixels</p>
            </div>
            <div class="card tint" style="--c:#64748b" data-step="2">
              <h3>Text('5') becomes Text('5')</h3>
              <p>A new widget object, but the same data. The RenderObject sees no change, so it skips layout and paint.</p>
              <p class="mt-2 font-mono text-xs" style="color:#94a3b8">build() ran {'-->'} nothing else. No new pixels.</p>
            </div>
          </div>
          <div data-step="3">
            <Flow
              col
              steps={[
                { t: 'element.update(newWidget)', c: 'violet' },
                { t: 'updateRenderObject()', c: 'green' },
                { t: 'value changed?', s: 'no: stop here', c: 'slate' },
                { t: 'markNeedsLayout / markNeedsPaint', c: 'green' },
                { t: 'flushLayout --> flushPaint', c: 'green' },
                { t: 'compositeFrame', s: 'sent to the GPU', c: 'green' },
              ]}
            />
          </div>
        </div>
        <div class="takeaway note" data-step="4">
          build() is cheap: it only creates small objects. Layout and paint are the costly parts, and Flutter does them only
          when something actually changed.
        </div>
      </Slide>

      <!-- 11 WHERE ---------------------------------------------------- -->
      <Slide
        n={12}
        chapter="Where"
        kicker="Try it"
        title="Where does the rebuild reach?"
        lead="Choose where the State lives, then press setState(). Watch which Elements light up."
      >
        <div class="cols c2" id="demo-tree">
          <div>
            <ul class="tree" id="tree">
              <li data-n="app">
                <span class="tn">MyApp</span>
                <ul>
                  <li data-n="mat">
                    <span class="tn">MaterialApp</span>
                    <ul>
                      <li data-n="home">
