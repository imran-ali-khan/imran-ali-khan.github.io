---
import StudyLayout from '@/layouts/StudyLayout.astro';
import { episodes, seriesName, seriesIntro } from '@/data/study';

const base = import.meta.env.BASE_URL;
---

<StudyLayout title={`${seriesName} | Visual Flutter lessons`} description={seriesIntro}>
  <div class="study-bg"></div>
  <div class="study-page">
    <div class="study-sheet">
      <h1 class="study-title">Flutter<br />Under <em>the Hood</em></h1>
      <p class="study-intro">{seriesIntro}</p>
      {
        episodes.map((ep) => (
          <a class="study-card" href={`${base}study/${ep.slug}/`}>
            <small>Episode {String(ep.number).padStart(2, '0')} &middot; {ep.slides} short scenes</small>
            <h2>{ep.title}</h2>
            <p>{ep.summary}</p>
            <span class="btn primary">Open the lesson &rarr;</span>
          </a>
        ))
      }
    </div>
  </div>
</StudyLayout>
