---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Imran Ali Khan" description="This page doesn't exist." noindex>
  <section class="section flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="section-label">404</p>
    <h1 class="mt-4 text-3xl font-semibold text-ink-50 sm:text-4xl">Page not found</h1>
    <p class="mt-3 max-w-md text-ink-400">The page you're looking for doesn't exist or has moved.</p>
    <a href={import.meta.env.BASE_URL} class="btn-primary mt-8">Back to home</a>
  </section>
</BaseLayout>
